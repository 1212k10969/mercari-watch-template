# Copy to .env. Real search terms and credentials belong only in .env / GitHub Secrets.
# Keep JSON on one line. [] disables monitoring until you provide your own rules.
WATCHLIST_JSON='[]'
# Rule sources: jp, tw, yahoo_fleamarket, yahoo_auctions.
# tw is Mercari's cross-border Taiwan storefront, not a local-stock comparison.
DISCORD_WEBHOOK_URL=
# Optional independent destination; select it with a rule's discord_webhook_env.
DISCORD_WEBHOOK_URL_SECONDARY=
# original or buyee. Buyee mode changes Mercari notification links, not identity/history.
MERCARI_LINK_MODE=original
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Generate with the README command; keep the same key between scheduled runs.
MONITOR_STATE_KEY=
MONITOR_STATE_PATH=.state/seen.enc
